{
  "/api/auth/**": {
    "target": "https://localhost:5001",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": {
      "^/api/auth": "/api"
    }
  },
  "/api/business/**": {
    "target": "https://localhost:6001",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": {
      "^/api/business": "/api"
    }
  }
}